<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 제목 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="앱 사용을 위한 권한 안내"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="정확한 서비스 제공을 위해 아래 권한이 필요합니다"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginBottom="32dp"/>

        <!-- 알림 수집 권한 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔 알림 수집 권한"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="앱 사용 패턴 분석을 위해 알림 접근 권한이 필요합니다"
                android:textSize="13sp"
                android:textColor="#555555"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnNotification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="알림 접근 허용하기"/>
        </LinearLayout>

        <!-- 배터리 최적화 해제 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔋 배터리 최적화 해제"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="백그라운드에서도 정확한 데이터 수집을 위해 배터리 최적화를 해제해주세요"
                android:textSize="13sp"
                android:textColor="#555555"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="배터리 최적화 해제하기"/>
        </LinearLayout>

        <!-- 사용 정보 접근 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 사용 정보 접근 허용"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="디바이스 사용 통계에 접근하여 스크린 타임을 측정합니다"
                android:textSize="13sp"
                android:textColor="#555555"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnUsageStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="사용 정보 접근 허용하기"/>
        </LinearLayout>

        <!-- 데이터 수집 항목 안내 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#EEF5FF"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 데이터 수집 항목"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• 앱 사용 시간\n• 앱 전환 빈도\n• 알림 확인 패턴"
                android:textSize="13sp"
                android:textColor="#555555"/>
        </LinearLayout>

        <!-- 익명화 보장 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F0FFF0"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 익명화 보장"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="서버 전송 시 모든 데이터는 익명화되어 개인을 특정할 수 없습니다"
                android:textSize="13sp"
                android:textColor="#555555"/>
        </LinearLayout>

        <!-- 개인정보 동의 체크박스 -->
        <CheckBox
            android:id="@+id/cbAgree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="(필수) 개인정보 수집 및 이용에 동의합니다.\n수집된 데이터는 사용 패턴 분석 및 맞춤형 서비스 제공을 위해서만 사용됩니다."
            android:textSize="13sp"
            android:layout_marginBottom="16dp"/>

        <!-- 다음 버튼 -->
        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="동의하고 시작하기"
            android:textSize="16sp"/>

    </LinearLayout>
</ScrollView>